# ;llm — Google Gemini.
# Comma-separated Gemini API keys. Google: "Rate limits are applied per
# project, not per API key" — so extra keys minted inside one project buy no
# extra capacity; one key per project is what widens the pool. Note that
# free-tier prompts and responses ARE used by Google to improve its products.
# Environment keys stay process-only and are never copied into SQLite. The bot
# owner can also use `;llm keys <key> ...` in a private owner-only channel;
# uploaded keys are stored in user.db. The environment is the safer route.
export GEMINI_API_KEYS=""
# xAI powers `;llm +grok ...` and the literal `@grok ...` trigger. Keys can
# also be added at runtime with `;llm grokkeys <key> ...` by the bot owner in a
# private owner-only channel; that fallback stores the key in user.db.
# API use requires prepaid credits or an invoiced account; a valid key alone
# does not grant model access. XAI_API_KEYS (comma-separated) is also accepted.
export XAI_API_KEY=""
export XAI_MODEL="grok-4.5"
# Optional strongest-to-weakest fallback ladder. Every listed model may have a
# different price; update the cost settings below to the most expensive one.
export XAI_MODELS="grok-4.5"
# Grok-only credit guard. These are the regular-user defaults; guild moderators
# can override them with `;ai ratelimit`. Configured Admin/Moderator roles
# bypass only the personal guard. Count-limit responses tell users when to
# retry, while the bot-wide request and spend thresholds stay private. The
# output cap covers both Grok's hidden reasoning and its visible answer.
export XAI_MAX_OUTPUT_TOKENS="1536"
export XAI_USER_RATE_LIMIT="15"
export XAI_USER_RATE_WINDOW_SECONDS="3600"
export XAI_DAILY_REQUEST_LIMIT="200"
# Private spend guard; ordinary users only see that daily capacity is used.
export XAI_DAILY_BUDGET_USD="0.50"
export XAI_INPUT_USD_PER_MILLION="2.00"
export XAI_OUTPUT_USD_PER_MILLION="6.00"
export XAI_REQUEST_RESERVE_INPUT_TOKENS="6000"

# End-to-end request/concurrency protection.
export LLM_REQUEST_TIMEOUT_SECONDS="90"
export LLM_ROUTER_TIMEOUT_SECONDS="15"
export LLM_QUEUE_TIMEOUT_SECONDS="10"
export LLM_GEMINI_CONCURRENCY="3"
export LLM_XAI_CONCURRENCY="2"
export LLM_TELEMETRY_RETENTION_DAYS="30"
# Model ladder, tried in order. Each entry is a separate quota bucket on the
# same key, not the same allowance renamed — so this multiplies capacity.
# Verified July 2026: all listed models are current and free-tier eligible.
# gemini-2.0-flash and gemini-2.0-flash-lite are shut down; don't use them.
export LLM_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash"
# Gemini deliberately has no per-user cap or cooldown; the shared free-tier
# allowance is its only limit. Calls are still counted per user so the bot
# owner can inspect consumption via `;llm keystatus`.
#
# Replies and unmistakable channel-history requests are routed locally;
# ambiguous questions use one cheap provider routing call. Set
# LLM_CONTEXT_ENABLED=0 to skip non-reply history and provider routing.
# Guild moderators can choose `auto`, `explicit`, or `off` with `;llm privacy`.
# Users can request `+context`, force `+direct`, and cap context with
# `messages=N` (up to LLM_CONTEXT_MESSAGES).
export LLM_CONTEXT_ENABLED="1"
# Maximum non-reply speaker turns; consecutive messages from one author share a turn.
export LLM_CONTEXT_MESSAGES="50"
export LLM_CONTEXT_WINDOW_SECONDS="600"

# Recent non-reply context follows the active conversation backward
# until an inactivity gap or hard maximum age is reached.
export LLM_CONTEXT_GAP_SECONDS="600"
export LLM_CONTEXT_RECENT_MAX_AGE_SECONDS="21600"

# Set to enable automatic venv usage.
export VENV_DIR=""
