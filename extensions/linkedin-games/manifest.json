{
  "manifest_version": 3,
  "name": "TLE LinkedIn Games",
  "version": "1.0.0",
  "description": "Preview and import LinkedIn game leaderboards into your Discord server.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Import LinkedIn leaderboard",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
